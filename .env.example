# =====================================================================
# Punjab School Education Department (SED) - Teacher Promotion Portal
# Production Environment Variables Configuration Template
# =====================================================================
# Copy this file to '.env' on your production server:
# cp .env.example .env
# Edit '.env' with your secure production values.
# =====================================================================

# Flask Environment & Debug Mode
FLASK_ENV=production
FLASK_DEBUG=0

# Secret Key for Session Signing & CSRF Protection
# Generate a cryptographically strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars-minimum

# Database Connection URI
# SQLite (default, self-contained):
# DATABASE_URL=sqlite:///instance/teacher_promotion.db
# PostgreSQL (recommended for high concurrency production):
# DATABASE_URL=postgresql://user:password@localhost:5432/sed_promotion_db
# MySQL / MariaDB:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sed_promotion_db
DATABASE_URL=sqlite:///instance/teacher_promotion.db

# Inactivity Session Auto-Logout Timeout (in minutes)
# Statutory default is 10 minutes.
SESSION_TIMEOUT_MINUTES=10

# Server Binding & Port (Used by run.py / containerized hosting)
HOST=0.0.0.0
PORT=5000

# File Upload Limit (in bytes; 33554432 = 32 MB)
MAX_CONTENT_LENGTH=33554432
